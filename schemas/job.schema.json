{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fitmark:schema:job:1",
  "title": "Fitmark job index (job.yaml)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "spec_id",
    "client",
    "client_slug",
    "job_slug",
    "role",
    "status",
    "current_spec_version",
    "submittals"
  ],
  "properties": {
    "spec_id": { "type": "string", "minLength": 1 },
    "client": { "type": "string", "minLength": 1 },
    "client_slug": { "type": "string", "minLength": 1 },
    "job_slug": { "type": "string", "minLength": 1 },
    "role": { "type": "string", "minLength": 1 },
    "status": {
      "enum": ["intake", "spec_sent", "confirmed", "on_hold", "filled", "closed"]
    },
    "current_spec_version": { "type": "integer", "minimum": 0 },
    "submittals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["candidate", "spec_version", "file", "date"],
        "properties": {
          "candidate": { "type": "string", "minLength": 1 },
          "spec_version": { "type": "integer", "minimum": 1 },
          "file": { "type": "string", "pattern": "^submittal-s[0-9]+(-[0-9]+)?\\.json$" },
          "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" }
        }
      }
    }
  }
}
