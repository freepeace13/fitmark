{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fitmark:schema:job-spec:1",
  "title": "Fitmark job spec",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema_version",
    "spec_id",
    "version",
    "created_at",
    "client",
    "role_title",
    "recruiter",
    "status",
    "summary",
    "must_haves",
    "nice_to_haves",
    "deal_breakers",
    "compensation",
    "location",
    "interview_process",
    "commercial_terms",
    "open_questions",
    "rubric",
    "changelog"
  ],
  "properties": {
    "$schema_version": { "const": "1.0" },
    "spec_id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "version": { "type": "integer", "minimum": 1 },
    "created_at": { "$ref": "#/$defs/date" },
    "client": { "type": "string", "minLength": 1 },
    "role_title": { "type": "string", "minLength": 1 },
    "recruiter": { "type": ["string", "null"] },
    "status": { "enum": ["draft", "sent_for_confirmation", "confirmed"] },
    "summary": { "type": "string" },
    "must_haves": {
      "type": "array",
      "items": { "$ref": "#/$defs/mustHave" }
    },
    "nice_to_haves": {
      "type": "array",
      "items": { "$ref": "#/$defs/niceToHave" }
    },
    "deal_breakers": { "type": "array", "items": { "type": "string" } },
    "compensation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["currency", "min", "max", "period", "notes"],
      "properties": {
        "currency": { "type": ["string", "null"] },
        "min": { "type": ["number", "null"] },
        "max": { "type": ["number", "null"] },
        "period": { "enum": ["hour", "day", "month", "year", null] },
        "notes": { "type": "string" }
      }
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "timezone_overlap", "notes"],
      "properties": {
        "mode": { "enum": ["remote", "hybrid", "onsite", null] },
        "timezone_overlap": { "type": ["string", "null"] },
        "notes": { "type": "string" }
      }
    },
    "interview_process": { "type": "array", "items": { "type": "string" } },
    "commercial_terms": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fee", "exclusivity", "deadline"],
      "properties": {
        "fee": { "type": ["string", "null"] },
        "exclusivity": { "type": ["string", "null"] },
        "deadline": { "type": ["string", "null"] }
      }
    },
    "open_questions": { "type": "array", "items": { "type": "string" } },
    "rubric": { "type": "array", "items": { "$ref": "#/$defs/criterion" } },
    "changelog": { "type": "array", "items": { "$ref": "#/$defs/changelogEntry" } }
  },
  "$defs": {
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "source": {
      "description": "Where a requirement came from. Library criteria must also set inferred: true.",
      "enum": ["client", "library"]
    },
    "mustHave": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text", "inferred"],
      "properties": {
        "id": { "type": "string", "pattern": "^mh-\\d+$" },
        "text": { "type": "string", "minLength": 1 },
        "client_quote": { "type": ["string", "null"] },
        "how_to_verify": { "type": ["string", "null"] },
        "inferred": { "type": "boolean" },
        "source": { "$ref": "#/$defs/source" }
      }
    },
    "niceToHave": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text", "inferred"],
      "properties": {
        "id": { "type": "string", "pattern": "^nh-\\d+$" },
        "text": { "type": "string", "minLength": 1 },
        "client_quote": { "type": ["string", "null"] },
        "inferred": { "type": "boolean" },
        "source": { "$ref": "#/$defs/source" }
      }
    },
    "criterion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["criterion_id", "weight", "evidence", "anchors"],
      "properties": {
        "criterion_id": { "type": "string" },
        "weight": { "type": "number", "exclusiveMinimum": 0 },
        "evidence": { "type": "string" },
        "anchors": {
          "type": "object",
          "minProperties": 2,
          "propertyNames": { "pattern": "^\\d+$" },
          "additionalProperties": { "type": "string" }
        }
      }
    },
    "changelogEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "date", "source", "changes"],
      "properties": {
        "version": { "type": "integer", "minimum": 2 },
        "date": { "$ref": "#/$defs/date" },
        "source": { "type": "string", "minLength": 1 },
        "changes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["field", "from", "to"],
            "properties": {
              "field": { "type": "string" },
              "from": {},
              "to": {},
              "may_invalidate_submittals": { "type": "boolean" }
            }
          }
        }
      }
    }
  }
}
