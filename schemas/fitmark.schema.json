{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fitmark:schema:workspace-marker:1",
  "title": "Fitmark workspace marker (fitmark.yaml)",
  "type": "object",
  "required": ["schema_version", "agency", "created_at"],
  "properties": {
    "schema_version": { "const": 1 },
    "agency": { "type": ["string", "null"] },
    "created_at": { "type": "string", "minLength": 1 }
  }
}
